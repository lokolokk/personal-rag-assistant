# Pass explicitly with --env-file; never copy real credentials into a build context.
LIVE_PROVIDER_ENABLED=false
LIVE_QWEN_API_KEY=
LIVE_QWEN_API_BASE=
LIVE_FRONTEND_ORIGIN=[]
LIVE_PORT=8081
# A later approved Pages build uses only public configuration:
# VITE_INVITED_ACCESS=1
# VITE_API_URL=https://APPROVED_BACKEND_HOST/api/v1
# VITE_NGROK_BYPASS=1 (only when ngrok selected)
