# Application Environment
PROJECT_NAME="Conversational Document RAG"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Storage Directories (Relative to project root or absolute)
STORAGE_DIR="storage"
UPLOAD_DIR="storage/uploads"
CHROMA_PERSIST_DIR="storage/chroma"

# Cloud LLM & Embedding Credentials
OPENAI_API_KEY=""
OPENAI_API_BASE=""
LLM_MODEL="qwen3.8-flash"
EMBEDDING_MODEL="qwen3.7-text-embedding"
EMBEDDING_DIMENSION=1024
RAG_COST_DEBUG=0

# Ingestion & Chunking Hyperparameters
CHUNK_SIZE=600
CHUNK_OVERLAP=100

# Hybrid Retrieval & RRF Hyperparameters
RRF_K=60
DENSE_TOP_N=10
SPARSE_TOP_N=10
TOP_K=5

# Conversational Session Memory
MEMORY_WINDOW_TURNS=6
